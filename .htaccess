RewriteEngine On

# Keep existing files and directories accessible directly.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Friendly routes.
RewriteRule ^contact/?$ contact.html [L,NC]
RewriteRule ^send-contact/?$ send-contact.php [L,NC]
RewriteRule ^index/?$ index.html [L,NC]
